{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "apps/api", "--port", "8000"],
      "cwd": "apps/api",
      "port": 8000
    },
    {
      "name": "worker",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "app.worker"],
      "cwd": "apps/api"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "apps/web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "e2e-api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": ["e2e/run_api.py"],
      "cwd": "apps/api",
      "port": 8020
    },
    {
      "name": "e2e-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "apps/web", "run", "dev", "--", "--mode", "e2e"],
      "port": 5180
    }
  ]
}
