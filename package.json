{
  "name": "skj-bess-platform",
  "private": true,
  "version": "1.0.0",
  "description": "SKJ Energy Solutions internal BESS platform (web, Android, API)",
  "overrides": { "react": "19.3.0", "react-dom": "19.3.0" },
  "workspaces": [
    "apps/web",
