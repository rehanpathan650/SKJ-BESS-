# Copy to .env on the server and fill in every value. Never commit .env.
# Generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                       (JWT_SECRET, passwords)
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"   (DATA_ENCRYPTION_KEY)

ENVIRONMENT=production
APP_DOMAIN=bess.skjenergy.com
ALLOWED_EMAIL_DOMAINS=skjenergy.com

JWT_SECRET=
DATA_ENCRYPTION_KEY=

DB_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_BACKUP_PASSWORD=
REDIS_PASSWORD=

# AI bill extraction (optional; manual entry works without it)
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=100

# Email (verification, password reset, approvals)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@skjenergy.com

PUSH_ENABLED=false

# --- Scaling and monitoring (see docs/architecture.md) ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# File storage: local disk (default) or any S3-compatible store. Files are encrypted before upload either way.
# STORAGE_BACKEND=s3
# S3_BUCKET=skj-bess-files
# S3_ENDPOINT_URL=          # empty = AWS; e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# LOG_FORMAT=json
# SENTRY_DSN=               # optional error tracking (personal data is stripped)
# METRICS_TOKEN=            # bearer token for /api/v1/metrics; metrics are off in production without it

# One login for the whole app (no sign-up, no approval chain): quotations go straight from bill to PDF.
# SINGLE_USER_MODE=true
