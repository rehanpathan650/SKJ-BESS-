# Shared site configuration, imported by Caddyfile (production) and Caddyfile.staging.
encode zstd gzip

header {
	Strict-Transport-Security "max-age=63072000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "no-referrer"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Cross-Origin-Opener-Policy "same-origin"
	-Server
}

request_body {
	max_size 100MB
}

handle /api/* {
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}

handle {
	root * /srv/web
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	try_files {path} /index.html
	file_server
}

log {
	output stdout
	format json
}
